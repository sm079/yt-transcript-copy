{
  "manifest_version": 3,
  "name": "YT Transcript Copy",
  "version": "1.0.0",
  "description": "Adds a button under YouTube videos that copies the transcript to your clipboard.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
